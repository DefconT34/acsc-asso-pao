# ACSC v9.0-php - PHP natif (plus de Node/Passenger)
# Bloque secrets
<FilesMatch "^(database\.db.*|.*\.db.*|\.env.*)$">
  Require all denied
</FilesMatch>
Options -Indexes
DirectoryIndex public/index.html
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # health direct (racine /health -> api/health.php)
  RewriteRule ^health/?$ api/health.php [L]
  # health PHP direct - bypass rewrite pour debug (curl /api/health.php)
  RewriteRule ^api/health\.php$ api/health.php [L]
  RewriteRule ^api/health/?$ api/health.php [L]
  # diag bypass direct (evite router -> 404 si route manquante)
  RewriteRule ^api/diag\.php$ api/diag.php [L]
  RewriteRule ^api/diag/?$ api/diag.php [L]
  # API -> router unique (tout /api/* -> api/index.php)
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^api/(.*)$ api/index.php [L,QSA]
  # Root explicit -> SPA (evite 403 Directory quand / est un dossier)
  RewriteRule ^$ public/index.html [L]

  # SPA fallback: si pas fichier/dossier et pas /api -> public/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/index.html [L]
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
